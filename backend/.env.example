# Required application settings
JWT_SECRET=replace-with-a-long-random-secret

# Optional: create an administrator account on first boot
ADMIN_EMAIL=dispatcher@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Used by docker-compose; override these only for a non-Docker setup
DATABASE_URL=postgres://crashaid:crashaid@localhost:5432/crashaid
REDIS_URL=redis://localhost:6379

# Comma-separated allowed frontend origins
CORS_ORIGIN=http://localhost:5173
PORT=4000
